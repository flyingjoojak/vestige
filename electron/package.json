{
  "name": "vestige-desktop",
  "version": "0.3.0",
  "description": "Vestige 데스크탑 앱 (Electron 셸 + 파이썬 사이드카)",
  "main": "main.js",
  "author": "flyingjoojak",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.0"
  },
  "build": {
    "appId": "com.vestige.app",
    "productName": "Vestige",
    "icon": "icon.png",
    "afterPack": "./afterPack.js",
    "files": ["main.js", "preload.js", "loading.html", "icon.png"],
    "extraResources": [
      { "from": "../dist/vestige-backend", "to": "backend" }
    ],
    "win": { "target": ["nsis"], "icon": "icon.png", "artifactName": "Vestige-${version}-Windows.${ext}" },
    "nsis": { "installerLanguages": ["en_US"], "include": "installer.nsh" },
    "mac": { "target": "dmg", "category": "public.app-category.productivity", "icon": "icon-mac.png", "identity": null, "artifactName": "Vestige-${version}-macOS.${ext}" },
    "linux": { "target": "AppImage", "category": "Utility", "icon": "icon.png", "artifactName": "Vestige-${version}-Linux.${ext}" },
    "publish": [
      { "provider": "github", "owner": "flyingjoojak", "repo": "vestige" }
    ]
  }
}
